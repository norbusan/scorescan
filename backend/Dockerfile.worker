# Use Ubuntu 24.04 as base for Audiveris compatibility
FROM ubuntu:24.04

WORKDIR /app

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install Python and system dependencies (including OpenCV dependencies)
RUN apt-get update && apt-get install -y \
    python3.12 \
    python3.12-venv \
    wget \
    libfreetype6 \
    fontconfig \
    libasound2t64 \
    libxext6 \
    libxrender1 \
    libxtst6 \
    libxi6 \
    libgtk-3-0 \
    libnss3 \
    libgbm1 \
    libxss1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2t64 \
    xvfb \
    libglib2.0-0 \
    libsm6 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Audiveris 5.11.0 from .deb package (includes JRE)
RUN wget -q https://github.com/Audiveris/audiveris/releases/download/5.11.0/Audiveris-5.11.0-ubuntu24.04-x86_64.deb -O /tmp/audiveris.deb \
    && apt-get update \
    && mkdir -p /usr/share/desktop-directories/ \
    && apt-get install -y /tmp/audiveris.deb \
    && rm /tmp/audiveris.deb \
    && rm -rf /var/lib/apt/lists/*

# Install MuseScore 4 - Extract AppImage instead of running it (FUSE doesn't work in Docker)
RUN wget -q https://github.com/musescore/MuseScore/releases/download/v4.7.5/MuseScore-Studio-4.7.5.260831071-x86_64.AppImage -O /tmp/musescore.AppImage \
    && chmod +x /tmp/musescore.AppImage \
    && cd /opt \
    && /tmp/musescore.AppImage --appimage-extract \
    && mv squashfs-root musescore \
    && rm /tmp/musescore.AppImage \
    && ln -s /opt/musescore/AppRun /usr/local/bin/musescore

# Set environment variables
ENV AUDIVERIS_PATH="/opt/audiveris/bin/Audiveris"
ENV MUSESCORE_PATH="/usr/local/bin/musescore"
ENV QT_QPA_PLATFORM=offscreen

# Create symlink for python
RUN ln -sf /usr/bin/python3.12 /usr/bin/python3 && \
    ln -sf /usr/bin/python3 /usr/bin/python

# Install uv for dependency management
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

# Install dependencies (including the oemer deep-learning OMR fallback)
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --group oemer --no-install-project

# Copy application code
COPY . .

# Create storage directories and non-root user
RUN useradd -m -r appuser && \
    mkdir -p storage/uploads storage/musicxml storage/pdf && \
    chown -R appuser:appuser /app

USER appuser

# Pre-warm oemer: on first use it downloads ~500MB of ONNX model weights into
# ~/.cache/oemer. Baking them into the image avoids a long cold start on the
# first real job. We feed oemer a blank page; it will "fail" to recognise any
# notes, which is fine — we only care about the side effect of the model
# download being completed and cached under the appuser home.
RUN python3 -c "from PIL import Image; Image.new('RGB',(640,480),'white').save('/tmp/prewarm.png')" \
    && (oemer -o /tmp /tmp/prewarm.png || true) \
    && rm -f /tmp/prewarm.png /tmp/prewarm.musicxml

CMD ["python3", "-m", "celery", "-A", "app.tasks.celery_app", "worker", "--loglevel=info"]
