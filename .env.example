# Docker Compose environment variables
SECRET_KEY=your-super-secret-key-change-me-in-production

# Debug mode (set to true for verbose auth logging)
DEBUG=false

# Frontend API URL
# Leave empty for relative URLs (recommended for Apache/nginx proxy)
# Set to http://localhost:8000 for local development without proxy
VITE_API_URL=

# CORS Origins (comma-separated list of allowed origins)
# Add your domain when running behind a proxy: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Interface the backend (8000) and frontend (5173) ports are published on.
# Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 exposes them directly.
# BIND_ADDRESS=127.0.0.1

# Proxies whose X-Forwarded-For header is trusted (IPs or CIDRs)
# FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12

# Email Configuration (for password reset)
#
# AUTHENTICATED MODE (Gmail, SendGrid, etc.):
#   Provide both SMTP_USERNAME and SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=ScoreScan
#
# UNAUTHENTICATED MODE (local mail relay, Docker host SMTP):
#   Leave both SMTP_USERNAME and SMTP_PASSWORD empty
#   Use host.docker.internal for host services in Docker
# SMTP_HOST=host.docker.internal
# SMTP_PORT=25
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_FROM_NAME=ScoreScan

# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:5173

# Upload limits (per upload / per page)
# MAX_UPLOAD_SIZE_MB=50
# MAX_PAGES=30
# MAX_IMAGE_MEGAPIXELS=60
